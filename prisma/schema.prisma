generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  role          String    @default("user")
  status        String    @default("active")

  timeZone      String    @default("UTC")

  timelineConfig Json?

  accounts      Account[]
  sessions      Session[]

  invitedUsers  Invite[]  @relation("invitedBy")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        String    @default("user")

  invitedById String?
  invitedBy   User?     @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model TwitchChannel {
  id               String   @id @default(cuid())
  login            String   @unique
  broadcasterId    String   @unique
  displayName      String?

  colorHex         String?

  sortOrder        Int      @default(0)

  timeZone         String?

  isEnabled        Boolean  @default(true)
  pollSchedule     Boolean  @default(true)
  pollStreams      Boolean  @default(true)
  pollVideos       Boolean  @default(true)

  lastScheduleSyncAt DateTime?
  lastStreamSyncAt   DateTime?
  lastVideoSyncAt    DateTime?

  scheduleSegments  TwitchScheduleSegment[]
  streamSnapshots   TwitchStreamSnapshot[]
  videos            TwitchVideo[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
}

model TwitchScheduleSegment {
  id          String   @id @default(cuid())
  channelId   String

  twitchId    String
  title       String?

  startTime   DateTime
  endTime     DateTime
  isCanceled  Boolean  @default(false)

  channel     TwitchChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, twitchId])
  @@index([channelId, startTime])
}

model TwitchStreamSnapshot {
  id          String   @id @default(cuid())
  channelId   String

  isLive      Boolean
  streamId    String?
  startedAt   DateTime?
  viewerCount Int?
  title       String?

  polledAt    DateTime @default(now())

  channel     TwitchChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, polledAt])
}

model TwitchVideo {
  id              String   @id @default(cuid())
  channelId       String

  twitchId        String   @unique
  streamId        String?
  type            String?
  title           String?
  description     String?
  url             String?
  thumbnailUrl    String?
  viewCount       Int?
  language        String?
  durationSeconds Int?
  startedAt       DateTime?
  endedAt         DateTime?

  lastSeenAt      DateTime @default(now())

  channel         TwitchChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([channelId, startedAt])
}
