# Local development database (Docker Postgres in docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twitch24_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Email magic link sender
EMAIL_FROM="twitch-24 <no-reply@example.com>"

# Optional (prod): Resend for actually sending emails.
# If not set, dev will log the magic link URL to the server console.
RESEND_API_KEY=""

TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

CRON_SECRET=""
